# Browser calls always use same-origin /api. Never place credentials in NEXT_PUBLIC_*.
# Internal proxy destination (server-only); changing the public domain does not change this.
LTX_INTERNAL_API_ORIGIN=http://127.0.0.1:8787

# Absolute path to a working LTX-2/LTX-2.3 checkout with its Python virtual environment.
LTX_REPO_ROOT=/absolute/path/to/LTX-2
LTX_PYTHON=/absolute/path/to/LTX-2/.venv/bin/python

# Local service configuration. Keep the API bound to loopback.
LTX_API_HOST=127.0.0.1
LTX_API_PORT=8787
LTX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local accounts. HTTPS is mandatory except loopback development.
LTX_USER_AUTH_ENABLED=1
LTX_PUBLIC_ORIGIN=http://localhost:3000
# verified_email (safe default) or internal (trusted testing without any email).
# Internal still requires passwords, sessions, CSRF and private media. It does NOT verify email ownership.
LTX_AUTH_MODE=verified_email
# Open only after private-file migration; verified_email also requires tested SMTP.
LTX_REGISTRATION_ENABLED=0
LTX_USER_DAILY_JOB_LIMIT=20

# Optional: register locally, append email once to a Cloudflare Access EMAIL list.
# Cloudflare sends its OTP only when the user visits its Access login page.
# Keep disabled until the list/policy/OTP provider and token have been verified.
LTX_CF_ACCESS_ENABLED=0
LTX_CF_ACCOUNT_ID=
LTX_CF_EMAIL_LIST_ID=
LTX_CF_PUBLIC_ORIGIN=
LTX_CF_TEAM_DOMAIN=
LTX_CF_AUDIENCE=
# Dedicated token: prefer granular Zero Trust list write permission if available.
# If the console offers only broader Zero Trust Edit, get explicit admin approval first.
# Scope the token to the owning account; see docs/CLOUDFLARE_ACCOUNT_SYNC.md.
# Do not reuse a Tunnel/build token, put secrets in NEXT_PUBLIC_*, or commit them.
LTX_CF_API_TOKEN_FILE=

# Verification/reset email. No mail is sent until the provider is configured.
LTX_SMTP_HOST=
LTX_SMTP_PORT=587
LTX_SMTP_SECURITY=starttls
LTX_SMTP_FROM=
LTX_SMTP_USERNAME=
# Use an ignored, non-symlink file with chmod 0600; never commit or paste its content.
# LTX_SMTP_PASSWORD_FILE=/absolute/private/path/to/smtp-password
# Alternatively provide LTX_SMTP_PASSWORD through a server secret manager.

# Trusted host-installed adapters only; comma-separated Python modules.
# LTX_MODEL_ADAPTERS=local_adapters.my_image_model,local_adapters.my_text_model

# Server-to-server worker authentication (never prefix with NEXT_PUBLIC_).
# Default key file: data/worker/api-key. Create once: python3 scripts/init-worker-key.py
# LTX_WORKER_API_KEY_FILE=/absolute/private/path/to/worker-api-key
# Alternatively supply LTX_WORKER_API_KEY via your server's secret manager (32+ characters).

# Optional model overrides.
# LTX_CHECKPOINT_PATH=/absolute/path/to/ltx-2.3-22b-distilled-1.1.safetensors
# LTX_UPSAMPLER_PATH=/absolute/path/to/ltx-2.3-spatial-upscaler-x2-1.1.safetensors
# LTX_GEMMA_ROOT=/absolute/path/to/gemma-3-12b

# Generation deadline (seconds), including output validation. Default 3600, range 30–7200.
# Each API request may override it using timeout_seconds within the same range.
LTX_JOB_TIMEOUT_SECONDS=3600
# Host frame ceiling: 8n+1, range 257–1201. 481 is about 20.04 s at 24 FPS.
# Larger ceilings require host-specific GPU/memory testing; not a quality guarantee.
LTX_MAX_FRAMES=481
# Private staging/log directory; must share a filesystem with LTX_OUTPUT_DIR for atomic publication.
# Never put this directory under public/ or serve it via HTTP.
# LTX_WORK_DIR=/absolute/private/path/to/worker-work
# Outputs default to data/worker/outputs; keep this outside public/ and dist/client/.
# LTX_OUTPUT_DIR=/absolute/private/path/to/worker-outputs
