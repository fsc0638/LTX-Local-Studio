# Browser API URL. Use the local API during development; leave empty behind a same-origin reverse proxy.
NEXT_PUBLIC_LTX_API_BASE=http://127.0.0.1:8787
# Leave empty when generated media is served by the web origin.
NEXT_PUBLIC_LTX_MEDIA_BASE=

# Absolute path to a working LTX-2/LTX-2.3 checkout with its Python virtual environment.
LTX_REPO_ROOT=/absolute/path/to/LTX-2
LTX_PYTHON=/absolute/path/to/LTX-2/.venv/bin/python

# Local service configuration. Keep the API bound to loopback.
LTX_API_HOST=127.0.0.1
LTX_API_PORT=8787
LTX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional model overrides.
# LTX_CHECKPOINT_PATH=/absolute/path/to/ltx-2.3-22b-distilled-1.1.safetensors
# LTX_UPSAMPLER_PATH=/absolute/path/to/ltx-2.3-spatial-upscaler-x2-1.1.safetensors
# LTX_GEMMA_ROOT=/absolute/path/to/gemma-3-12b
